# Production platform feature switches. Load these in a controlled release
# environment; secrets and kubeconfig are managed separately.
INSTALL_CERT_MANAGER=true
INSTALL_KURED=true
INSTALL_SYSTEM_UPGRADE_CONTROLLER=true
INSTALL_KEDA=true
INSTALL_OPENOBSERVE=true
INSTALL_STORAGE=true
INSTALL_OTEL_OPERATOR=true
APPLY_COLLECTOR=true
APPLY_EDGE_RESOURCES=false
APPLY_ISSUERS=false
APPLY_DASHBOARDS=false

# Signal collectors. Journald, audit and Hubble flow events are opt-in because
# they need privileged host access, K3s API audit configuration, or can produce
# high event volume. Kubernetes Event objects are low-volume and enabled by default.
APPLY_HOST_JOURNALD=false
APPLY_KUBERNETES_AUDIT=false
APPLY_KUBERNETES_EVENTS=true
APPLY_HUBBLE_EVENTS=false
REMOVE_OPTIONAL_COLLECTORS=false

ENABLE_HUBBLE=true
# Optional override; when omitted it inherits APPLY_HUBBLE_EVENTS.
# ENABLE_HUBBLE_EVENTS=true
